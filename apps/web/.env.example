# Local development only. Never commit real values.
PROVIDER_CREDENTIAL_MASTER_KEY=replace-with-a-long-random-secret

# Optional workspace-owned provider credentials. Users can also connect BYOK in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.5-flash
CHECKPOINT_GEMINI_MODEL=gemini-2.5-flash-lite
CHECKPOINT_TIMEOUT_MS=8500
CHECKPOINT_MAX_OUTPUT_TOKENS=2000
CHECKPOINT_USER_PER_MINUTE=10
CHECKPOINT_IP_PER_MINUTE=30
GEMINI_DAILY_SPEND_USD=2
# Conservative reservation prices; update if overriding the model.
GEMINI_INPUT_USD_PER_MILLION=1
GEMINI_OUTPUT_USD_PER_MILLION=5
PERPLEXITY_MODEL=sonar

# Checkpoint controls. The free tier uses GEMINI_API_KEY with a per-user daily limit.
GEMINI_DAILY_LIMIT=20
GEMINI_DAILY_INPUT_CHARS=400000
CHECKPOINT_MAX_INPUT_CHARS=40000
CHECKPOINT_TOKEN_BUDGET=1500

# Optional founder-only metrics. Never expose this value to clients.
FOUNDER_METRICS_USER_ID=
