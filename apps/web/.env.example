# Local development only. Never commit real values.
PROVIDER_CREDENTIAL_MASTER_KEY=replace-with-a-long-random-secret

# Optional workspace-owned provider credentials. Users can also connect BYOK in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides (defaults as of October 2026). Gemini 2.5 models are limited to
# accounts that already used them, so new keys need Gemini 3.x.
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-3.8-flash
CHECKPOINT_GEMINI_MODEL=gemini-3.5-flash-lite
PERPLEXITY_MODEL=sonar
CHECKPOINT_TIMEOUT_MS=8500
CHECKPOINT_MAX_OUTPUT_TOKENS=2000
CHECKPOINT_USER_PER_MINUTE=10
CHECKPOINT_IP_PER_MINUTE=30

# Platform-key spending. Every call made with the keys above (any provider) is reserved against
# one daily cap first; personal (BYOK) keys are not capped. GEMINI_DAILY_SPEND_USD is still read
# when this is unset.
PLATFORM_DAILY_SPEND_USD=2
# Conservative reservation prices per million (input is counted in characters); update if overriding a model.
GEMINI_INPUT_USD_PER_MILLION=1
GEMINI_OUTPUT_USD_PER_MILLION=5
ANTHROPIC_INPUT_USD_PER_MILLION=4
ANTHROPIC_OUTPUT_USD_PER_MILLION=20
OPENAI_INPUT_USD_PER_MILLION=5
OPENAI_OUTPUT_USD_PER_MILLION=25
PERPLEXITY_INPUT_USD_PER_MILLION=3
PERPLEXITY_OUTPUT_USD_PER_MILLION=15

# Checkpoint controls. The free tier uses GEMINI_API_KEY with a per-user daily limit.
GEMINI_DAILY_LIMIT=20
GEMINI_DAILY_INPUT_CHARS=400000
CHECKPOINT_MAX_INPUT_CHARS=40000
CHECKPOINT_TOKEN_BUDGET=1500

# Optional founder-only metrics. Never expose this value to clients.
FOUNDER_METRICS_USER_ID=
