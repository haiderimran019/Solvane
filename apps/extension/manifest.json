{
  "manifest_version": 3,
  "name": "Solvane Browser Bridge",
  "version": "0.1.0",
  "description": "Carry a reviewed Continuity Capsule between Claude, Gemini, ChatGPT, and Perplexity without provider API keys.",
  "permissions": ["storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
